# Public Data API configuration (safe in browser/mobile bundles)
NEXT_PUBLIC_SUPABASE_URL=https://uychwbumaseqbjkcyiyd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VITE_SUPABASE_URL=https://uychwbumaseqbjkcyiyd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Optional local-only credentials used by npm run test:supabase-auth.
PLANNER_AUTH_TEST_EMAIL=replace-with-test-account-email
PLANNER_AUTH_TEST_PASSWORD=replace-with-test-account-password

# Server/import tooling only. Never expose these through NEXT_PUBLIC_ or VITE_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_DB_URL=postgresql://postgres.uychwbumaseqbjkcyiyd:replace-with-url-encoded-password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Optional transaction-mode pooler. Normal clients use the Data API, not this URL.
SUPABASE_POOLER_URL=postgresql://postgres.uychwbumaseqbjkcyiyd:replace-with-url-encoded-password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# CLI authentication/linking; local secret only.
SUPABASE_ACCESS_TOKEN=replace-with-personal-access-token
SUPABASE_DB_PASSWORD=replace-with-database-password

# Production cutover: copy this file to .env.production.local and replace every
# value with the distinct production project's credentials. Administrative
# scripts accept: --env-file .env.production.local --confirm-production
